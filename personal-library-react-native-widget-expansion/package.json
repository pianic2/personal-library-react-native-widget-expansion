{
  "name": "@personal-library/react-native-widget-expansion",
  "version": "0.1.0",
  "description": "Cross-platform React Native surfaces activated from home screen widgets",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepack": "npm run build",
    "doctor": "expo install --check && npx expo-doctor",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "personal-library-react-native-widget-expansion",
    "PersonalLibraryWidgetExpansion"
  ],
  "repository": "https://github.com/pianic2/personal-library-react-native-widget-expansion",
  "bugs": {
    "url": "https://github.com/pianic2/personal-library-react-native-widget-expansion/issues"
  },
  "author": "Niccolò Piazzi <niccolo.piazzi01@gmail.com> (https://github.com/pianic2)",
  "license": "MIT",
  "homepage": "https://github.com/pianic2/personal-library-react-native-widget-expansion#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "~57.0.26",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
